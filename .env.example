```bash
# ============================================================
# Cloudflare Docs – environment variables
# Copy this file to .env.local and fill in the values you need.
# Never commit real secrets.
# ============================================================

# ---------- Algolia (public search-only key is fine) ----------
PUBLIC_ALGOLIA_APP_ID=D32WIYFTUF
PUBLIC_ALGOLIA_API_KEY=your_search_only_api_key_here

# ---------- Cloudflare API / Workers ----------
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CF_API_BASE_URL=

# ---------- GitHub (used by some scripts / contributors fetch) ----------
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=

# ---------- Jira (optional internal tooling) ----------
JIRA_AUTH_TOKEN=
JIRA_HOSTNAME=

# ---------- Cloudflare Access (optional) ----------
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# ---------- Misc / scripts ----------
BRANCH_SLUG=
CLIENT_ID=
USER_ID=
NODE_DEBUG=
REPORT_PATH=
RUN_LINK_CHECK=false
VERBOSE=false

# ---------- Local development ----------
# NODE_OPTIONS=--max-old-space-size=8192
